10 REM ------------------------------------------
20 REM  D-PAD DEMO - STEER A SPRITE
30 REM  MS-BASIC ON THE 6502 BOARD
40 REM ------------------------------------------
50 REM  THE FOUR BUTTONS SIT ON VIA2 PORT B AND
60 REM  ARE ACTIVE LOW, SO A PRESSED BUTTON
70 REM  READS AS A ZERO BIT:
80 REM    UP 8   LEFT 16   RIGHT 32   DOWN 64
90 REM  BIT 7 IS THE LED, BITS 0 AND 1 ARE
100 REM  OUTPUTS TOO - LEAVE THEM ALONE.
110 PV=34816
120 PRINT
130 PRINT "D-PAD DEMO"
140 PRINT
150 PRINT "PUSH THE PAD TO MOVE THE FACE."
160 PRINT "CTRL-C STOPS."
170 PRINT
180 PRINT "PRESS A BUTTON TO BEGIN."
190 IF (PEEK(PV) AND 120)=120 THEN 190
200 SCREEN 1
210 REM  SPRITE SHAPE 0 GOES TO 6144, EIGHT BYTES
220 FOR I=0 TO 7
230 READ B
240 VPOKE 6144+I,B
250 NEXT I
260 DATA 60,66,165,129,165,153,66,60
270 X=124 : Y=92
280 REM ---- MAIN LOOP -----------------------
290 SPRITE 0,X,Y,0,15
300 B=PEEK(PV)
310 IF (B AND 8)=0 THEN Y=Y-2
320 IF (B AND 64)=0 THEN Y=Y+2
330 IF (B AND 16)=0 THEN X=X-2
340 IF (B AND 32)=0 THEN X=X+2
350 IF X<0 THEN X=0
360 IF X>247 THEN X=247
370 IF Y<0 THEN Y=0
380 IF Y>183 THEN Y=183
390 GOTO 290
