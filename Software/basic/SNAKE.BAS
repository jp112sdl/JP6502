10 REM ------------------------------------------
20 REM  SNAKE
30 REM  MS-BASIC ON THE 6502 BOARD
40 REM  D-PAD ON VIA2 PORT B, ACTIVE LOW:
50 REM    UP 8   LEFT 16   RIGHT 32   DOWN 64
60 REM ------------------------------------------
70 PV=34816
80 REM  G() MARKS EVERY OCCUPIED CELL, WHICH TURNS
90 REM  THE COLLISION TEST INTO ONE ARRAY READ
100 REM  INSTEAD OF WALKING THE WHOLE BODY.
110 REM  S() IS THE BODY AS A RING BUFFER.
120 DIM G(768),S(400)
130 PRINT
140 PRINT "SNAKE"
150 PRINT
160 PRINT "EAT THE DOTS. DO NOT BITE YOURSELF"
170 PRINT "AND KEEP OFF THE WALLS."
180 PRINT
190 PRINT "PRESS A BUTTON TO START."
200 SD=SD+1
210 IF (PEEK(PV) AND 120)=120 THEN 200
220 Z=RND(-SD)
230 REM ---- SET UP THE FIELD ------------------
240 SCREEN 1
250 LINE 4,4,251,4,15
260 LINE 4,187,251,187,15
270 LINE 4,4,4,187,15
280 LINE 251,4,251,187,15
290 HX=16 : HY=12 : DX=1 : DY=0
300 HD=0 : TL=0 : LN=1 : SC=0
310 CE=HY*32+HX : S(0)=CE : G(CE)=1
320 DC=HX : DR=HY : DV=255 : GOSUB 900
330 GOSUB 800
340 REM ---- MAIN LOOP -------------------------
350 B=PEEK(PV)
360 IF (B AND 8)=0 AND DY=0 THEN DX=0 : DY=-1
370 IF (B AND 64)=0 AND DY=0 THEN DX=0 : DY=1
380 IF (B AND 16)=0 AND DX=0 THEN DX=-1 : DY=0
390 IF (B AND 32)=0 AND DX=0 THEN DX=1 : DY=0
400 HX=HX+DX : HY=HY+DY
410 IF HX<1 OR HX>30 OR HY<1 OR HY>22 THEN 700
420 CE=HY*32+HX
430 IF G(CE) THEN 700
440 IF CE=FD THEN 500
450 REM  NOT EATEN, SO THE TAIL COMES ALONG
460 TC=S(TL) : G(TC)=0
470 DR=INT(TC/32) : DC=TC-DR*32 : DV=0 : GOSUB 900
480 TL=TL+1 : IF TL>400 THEN TL=0
490 GOTO 520
500 REM  EATEN
510 SC=SC+1 : LN=LN+1 : SOUND 2000,1 : GOSUB 800
520 HD=HD+1 : IF HD>400 THEN HD=0
530 S(HD)=CE : G(CE)=1
540 DC=HX : DR=HY : DV=255 : GOSUB 900
550 GOTO 350
700 REM ---- GAME OVER -------------------------
710 SOUND 200,8
720 SCREEN 0
730 PRINT
740 PRINT "GAME OVER. YOU ATE ";SC
750 PRINT
760 END
800 REM ---- PUT A DOT SOMEWHERE FREE ----------
810 FD=INT(RND(1)*768)
820 FR=INT(FD/32) : FC=FD-FR*32
830 IF FC<1 OR FC>30 OR FR<1 OR FR>22 THEN 810
840 IF G(FD) THEN 810
850 FA=FR*256+FC*8
860 VPOKE FA+2,60 : VPOKE FA+3,126
870 VPOKE FA+4,126 : VPOKE FA+5,60
880 RETURN
900 REM ---- FILL OR CLEAR ONE 8X8 CELL --------
910 REM  A CHARACTER ROW IS ONE PAGE OF THE
920 REM  BITMAP, SO THE EIGHT ROWS OF PIXELS ARE
930 REM  EIGHT CONSECUTIVE ADDRESSES. UNROLLED
940 REM  ON PURPOSE - A FOR LOOP HERE COSTS MORE
950 REM  THAN THE EIGHT WRITES DO.
960 DA=DR*256+DC*8
970 VPOKE DA,DV : VPOKE DA+1,DV : VPOKE DA+2,DV : VPOKE DA+3,DV
980 VPOKE DA+4,DV : VPOKE DA+5,DV : VPOKE DA+6,DV : VPOKE DA+7,DV
990 RETURN
