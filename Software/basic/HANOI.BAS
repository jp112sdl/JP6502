10 REM ------------------------------------------
20 REM  TOWERS OF HANOI
30 REM  MS-BASIC ON THE 6502 BOARD
40 REM ------------------------------------------
50 PRINT
60 PRINT "TOWERS OF HANOI"
70 PRINT
80 PRINT "GET THE WHOLE PILE ONTO PEG 3."
90 PRINT "ONE DISK AT A TIME, AND NEVER A BIG"
100 PRINT "ONE ON TOP OF A SMALL ONE."
110 PRINT
120 INPUT "HOW MANY DISKS (3-7)";N
130 IF N<3 THEN 120
140 IF N>7 THEN 120
150 INPUT "PLAY IT YOURSELF, OR WATCH (P/W)";Q$
160 MD=0
170 IF LEFT$(Q$,1)="W" THEN MD=1
180 PRINT
190 REM  P(PEG,LEVEL) IS THE DISK SIZE, LEVEL 1
200 REM  IS THE BOTTOM, H(PEG) THE HEIGHT.
210 DIM P(3,N),H(3),B$(N)
220 REM  SN/SA/SC/SB/ST ARE THE CALL STACK THE
230 REM  WATCH MODE NEEDS - SEE LINE 2000.
240 DIM SN(N+2),SA(N+2),SC(N+2),SB(N+2),ST(N+2)
250 FOR I=1 TO N
260 P(1,I)=N-I+1
270 NEXT I
280 H(1)=N
290 H(2)=0
300 H(3)=0
310 M=0
320 REM  --- ONE PEG IS W CHARACTERS WIDE ---
330 W=2*N+1
340 E$=""
350 FOR I=1 TO W
360 E$=E$+" "
370 NEXT I
380 B$(0)=LEFT$(E$,N)+"|"+LEFT$(E$,N)
390 FOR J=1 TO N
400 K=N-J+1
410 T$=""
420 FOR I=1 TO 2*J-1
430 T$=T$+"*"
440 NEXT I
450 B$(J)=LEFT$(E$,K)+T$+LEFT$(E$,K)
460 NEXT J
470 F$=""
480 FOR I=1 TO W
490 F$=F$+"-"
500 NEXT I
510 F$=F$+" "+LEFT$(F$,W)+" "+LEFT$(F$,W)
512 PL$=""
514 FOR G=1 TO 3
516 PL$=PL$+LEFT$(E$,N)+CHR$(48+G)+LEFT$(E$,N)
518 IF G<3 THEN PL$=PL$+" "
519 NEXT G
520 IF MD=1 THEN 2000
530 REM ==========================================
540 REM  THE GAME
550 REM ==========================================
560 GOSUB 4000
570 IF H(3)=N THEN 800
580 PRINT M;"MOVES SO FAR,";2^N-1;"IS THE BEST"
590 INPUT "FROM,TO (0,0 GIVES UP)";FP,TP
600 IF FP=0 THEN 870
605 REM  EACH TEST HAS TO CLEAR OUT BEFORE THE
606 REM  NEXT ONE INDEXES AN ARRAY WITH IT. AND
607 REM  DOES NOT SHORT CIRCUIT HERE, SO A TYPED
608 REM  "4,1" WOULD REACH H(4) AND STOP WITH
609 REM  ?BS ERROR IF THIS WERE ONE EXPRESSION.
610 ER=0
620 IF FP<1 THEN ER=1
630 IF FP>3 THEN ER=1
640 IF TP<1 THEN ER=1
650 IF TP>3 THEN ER=1
655 IF ER>0 THEN 720
660 IF FP=TP THEN ER=2
665 IF ER>0 THEN 720
670 IF H(FP)=0 THEN ER=3
675 IF ER>0 THEN 720
680 IF H(TP)>0 AND P(TP,H(TP))<P(FP,H(FP)) THEN ER=4
690 IF ER>0 THEN 720
700 A=FP : C=TP : GOSUB 3000
710 GOTO 560
720 REM  --- THAT MOVE IS NOT ALLOWED ---
730 SOUND 90,20
740 IF ER=1 THEN PRINT "THE PEGS ARE 1, 2 AND 3."
750 IF ER=2 THEN PRINT "IT IS ALREADY ON THAT PEG."
760 IF ER=3 THEN PRINT "PEG";FP;"IS EMPTY."
770 IF ER=4 THEN PRINT "A DISK CANNOT SIT ON A SMALLER ONE."
780 PRINT
790 GOTO 580
800 REM  --- SOLVED ---
810 PRINT
820 PRINT "DONE, IN";M;"MOVES."
830 IF M=2^N-1 THEN PRINT "NOBODY CAN DO IT IN FEWER."
840 GOSUB 5000
850 PRINT
860 END
870 PRINT
880 PRINT "GIVING UP AFTER";M;"MOVES."
890 PRINT "TYPE RUN AND PICK W TO SEE IT DONE."
900 END
1990 REM ==========================================
2000 REM  WATCH MODE. THIS BASIC HAS NO RECURSION
2010 REM  - GOSUB TAKES NO ARGUMENTS AND KEEPS NO
2020 REM  LOCALS - SO THE FRAMES OF THE USUAL
2030 REM  HANOI(K,FROM,TO,VIA) LIVE IN ARRAYS AND
2040 REM  ST SAYS HOW FAR EACH ONE HAS GOT.
2050 GOSUB 4000
2060 SP=1
2070 SN(1)=N : SA(1)=1 : SC(1)=3 : SB(1)=2 : ST(1)=0
2080 IF SP=0 THEN 2260
2090 K=SN(SP)
2100 A=SA(SP)
2110 C=SC(SP)
2120 B=SB(SP)
2130 S=ST(SP)
2140 IF K=0 THEN 2240
2150 IF S=2 THEN 2240
2160 IF S=1 THEN 2200
2170 ST(SP)=1
2180 SP=SP+1 : SN(SP)=K-1 : SA(SP)=A : SC(SP)=B : SB(SP)=C : ST(SP)=0
2190 GOTO 2080
2200 GOSUB 3000
2210 ST(SP)=2
2220 SP=SP+1 : SN(SP)=K-1 : SA(SP)=B : SC(SP)=C : SB(SP)=A : ST(SP)=0
2230 GOTO 2080
2240 SP=SP-1
2250 GOTO 2080
2260 PRINT
2270 PRINT M;"MOVES, AND THAT IS THE MINIMUM."
2280 GOSUB 5000
2290 END
2990 REM  --- MOVE ONE DISK FROM PEG A TO PEG C ---
3000 X=P(A,H(A))
3010 H(A)=H(A)-1
3020 H(C)=H(C)+1
3030 P(C,H(C))=X
3040 M=M+1
3050 SOUND 200+(N-X)*90,4
3060 IF MD=0 THEN RETURN
3070 PRINT "MOVE";M;"- DISK";X;"FROM";A;"TO";C
3080 GOSUB 4000
3090 RETURN
3990 REM  --- DRAW THE THREE PEGS ---
4000 FOR R=N TO 1 STEP -1
4010 L$=""
4020 FOR G=1 TO 3
4030 Z=0
4040 IF R<=H(G) THEN Z=P(G,R)
4050 L$=L$+B$(Z)
4060 IF G<3 THEN L$=L$+" "
4070 NEXT G
4080 PRINT L$
4090 NEXT R
4100 PRINT F$
4110 PRINT PL$
4120 PRINT
4130 RETURN
4990 REM  --- LITTLE FANFARE ---
5000 FOR I=1 TO 4
5010 READ FQ
5020 SOUND FQ,18
5030 NEXT I
5040 RESTORE
5050 RETURN
5060 DATA 262,330,392,523
