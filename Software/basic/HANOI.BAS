10 REM ------------------------------------------
20 REM  TOWERS OF HANOI
30 REM  MS-BASIC ON THE 6502 BOARD
40 REM ------------------------------------------
50 PRINT
60 PRINT "TOWERS OF HANOI"
70 PRINT
80 INPUT "HOW MANY DISKS (1-7)";N
90 IF N<1 THEN 80
100 IF N>7 THEN 80
110 INPUT "SHOW THE PEGS (Y/N)";Q$
120 DS=0
130 IF LEFT$(Q$,1)="Y" THEN DS=1
140 PRINT
150 REM  P(PEG,LEVEL) IS THE DISK SIZE, LEVEL 1
160 REM  IS THE BOTTOM, H(PEG) THE HEIGHT.
170 DIM P(3,N),H(3),B$(N)
180 REM  SN/SA/SC/SB/ST ARE THE CALL STACK THAT
190 REM  STANDS IN FOR THE RECURSION THIS BASIC
200 REM  HAS NO WAY OF DOING BY ITSELF.
210 DIM SN(N+2),SA(N+2),SC(N+2),SB(N+2),ST(N+2)
220 FOR I=1 TO N
230 P(1,I)=N-I+1
240 NEXT I
250 H(1)=N
260 H(2)=0
270 H(3)=0
280 M=0
290 REM  --- ONE PEG IS W CHARACTERS WIDE ---
300 W=2*N+1
310 E$=""
320 FOR I=1 TO W
330 E$=E$+" "
340 NEXT I
350 B$(0)=LEFT$(E$,N)+"|"+LEFT$(E$,N)
360 FOR J=1 TO N
370 K=N-J+1
380 T$=""
390 FOR I=1 TO 2*J-1
400 T$=T$+"*"
410 NEXT I
420 B$(J)=LEFT$(E$,K)+T$+LEFT$(E$,K)
430 NEXT J
440 F$=""
450 FOR I=1 TO W
460 F$=F$+"-"
470 NEXT I
480 F$=F$+" "+LEFT$(F$,W)+" "+LEFT$(F$,W)
490 IF DS=1 THEN GOSUB 4000
500 REM  --- SOLVE: N DISKS FROM PEG 1 TO PEG 3 ---
510 SP=1
520 SN(1)=N
530 SA(1)=1
540 SC(1)=3
550 SB(1)=2
560 ST(1)=0
570 IF SP=0 THEN 850
580 K=SN(SP)
590 A=SA(SP)
600 C=SC(SP)
610 B=SB(SP)
620 S=ST(SP)
630 IF K=0 THEN 830
640 IF S=2 THEN 830
650 IF S=1 THEN 730
660 REM  STAGE 0 - GET THE K-1 DISKS ABOVE OUT
670 REM  OF THE WAY, ONTO THE SPARE PEG
680 ST(SP)=1
690 SP=SP+1
700 SN(SP)=K-1 : SA(SP)=A : SC(SP)=B : SB(SP)=C : ST(SP)=0
710 GOTO 570
720 REM  STAGE 1 - MOVE THE BIG ONE, THEN BRING
730 REM  THE K-1 ACROSS ON TOP OF IT
740 GOSUB 3000
750 ST(SP)=2
760 SP=SP+1
770 SN(SP)=K-1 : SA(SP)=B : SC(SP)=C : SB(SP)=A : ST(SP)=0
780 GOTO 570
790 REM  NOTHING LEFT TO DO IN THIS FRAME
830 SP=SP-1
840 GOTO 570
850 PRINT
860 PRINT M;"MOVES,";2^N-1;"IS THE MINIMUM"
870 END
2990 REM  --- MOVE ONE DISK FROM PEG A TO PEG C ---
3000 X=P(A,H(A))
3010 H(A)=H(A)-1
3020 H(C)=H(C)+1
3030 P(C,H(C))=X
3040 M=M+1
3050 PRINT "MOVE";M;"- DISK";X;"FROM";A;"TO";C
3060 FQ=200+(N-X)*90
3070 SOUND FQ,4
3080 IF DS=1 THEN GOSUB 4000
3090 RETURN
3990 REM  --- DRAW THE THREE PEGS ---
4000 FOR R=N TO 1 STEP -1
4010 L$=""
4020 FOR G=1 TO 3
4030 Z=0
4040 IF R<=H(G) THEN Z=P(G,R)
4050 L$=L$+B$(Z)
4060 IF G<3 THEN L$=L$+" "
4070 NEXT G
4080 PRINT L$
4090 NEXT R
4100 PRINT F$
4110 PRINT
4120 RETURN
